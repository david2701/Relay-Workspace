{
  "name": "relay",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @relay/server --filter @relay/web dev",
    "dev:server": "pnpm --filter @relay/server dev",
    "dev:web": "pnpm --filter @relay/web dev",
    "build": "pnpm -r run build",
    "build:core": "pnpm --filter @relay/core build",
    "typecheck": "pnpm run build:core && pnpm -r run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "biome check .",
    "test": "pnpm run build:core && pnpm --filter @relay/core test && pnpm --filter @relay/server test && pnpm --filter @relay/web test",
    "test:e2e": "pnpm run build:core && pnpm exec playwright test",
    "seed": "pnpm run build:core && pnpm --filter @relay/server seed",
    "seed:large": "pnpm run build:core && pnpm --filter @relay/server seed:large",
    "demo:ac3": "pnpm run build:core && pnpm --filter @relay/server demo:ac3",
    "contrast": "node scripts/contrast-matrix.mjs",
    "capture:ac12": "node scripts/capture-ac12.mjs",
    "benchmark:ac3": "node scripts/benchmark-ac3-sla.mjs",
    "benchmark:large": "node scripts/benchmark-large.mjs",
    "check:mcp-docs": "node scripts/check-mcp-docs-tools.mjs",
    "capture:mcp-examples": "node scripts/capture-mcp-examples.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.0",
    "eslint": "^9.36.0",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "typescript": ">=4.8.4"
      }
    }
  }
}
